<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="#F0F4F8">

    <TextView
        android:id="@+id/tvEventoTarea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/azul_oscuro"
        android:text="Leer Kotlin · Estudio"/>

    <TextView
        android:id="@+id/tvEventoInicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/gris_texto"
        android:text="Inicio: 2026-10-12 10:30"/>

    <TextView
        android:id="@+id/tvEventoFin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/gris_texto"
        android:text="Fin: 2026-10-12 11:15"/>

    <TextView
        android:id="@+id/tvEventoDuracion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/azul_oscuro"
        android:textStyle="bold"
        android:text="Duración: 45 min"/>

</LinearLayout>